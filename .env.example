# Server-only Vertex AI configuration. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Required on Vercel for keyless Workload Identity Federation.
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=eazo-vercel@your-google-cloud-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Server-only fal API-scope key for Z-Image Turbo illustrations.
FAL_KEY=

# Enhanced methods 1-3: Inco GLM 5.3 Flash (server-only)
INCO_API_KEY=
