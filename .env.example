# Offline sample-book analysis through PrimaLabs. Never prefix the key with NEXT_PUBLIC_.
PRIMALABS_API_KEY=your-primalabs-api-key
PRIMALABS_MODEL=primalabs-ai/MiMo-V2.6-Pro-RL

# Server-only Vertex AI configuration for existing cloud-upload processing.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
# Existing cloud-upload processing and other Vertex features still use Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash
# Optional server-only JSON performance logs. No prompts, source text or credentials.
EAZO_PERFORMANCE_LOG=0

# Required on Vercel for keyless Workload Identity Federation.
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=eazo-vercel@your-google-cloud-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Server-only fal API-scope key for Z-Image Turbo illustrations.
FAL_KEY=

# Production Explanation, Diagram, Interactive panel: Inco GLM 5.3 Flash (server-only; required)
INCO_API_KEY=

# Server-only image provider: fal (Z-Image Turbo) or bfl (FLUX.2 klein 9B).
IMAGE_PROVIDER=fal
BFL_API_KEY=

# Google-only account sync (server-only). Configure Google credentials in Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Canonical public HTTPS origin for deployed OAuth callbacks; use localhost for local testing.
EAZO_SITE_URL=http://127.0.0.1:3000
